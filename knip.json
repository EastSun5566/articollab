{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "test/**/*.test.ts"
      ],
      "project": [
        "test/**/*.{ts,js}",
        "scripts/**/*.ts",
        "examples/*.{ts,js}",
        "examples/shared/*.{ts,js}"
      ]
    },
    "packages/articollab": {
      "entry": [
        "src/index.ts",
        "src/react.ts",
        "src/sync/index.ts",
        "src/sync/node.ts",
        "src/sync/postgres.ts",
        "src/prosemirror/index.ts",
        "src/tiptap/index.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "examples/file-tree": {
      "entry": [
        "page.js",
        "test/**/*.test.ts"
      ],
      "project": [
        "*.{ts,js}",
        "test/**/*.ts"
      ]
    },
    "examples/kanban": {
      "entry": [
        "page.js",
        "test/**/*.test.ts"
      ],
      "project": [
        "*.{ts,js}",
        "test/**/*.ts"
      ]
    },
    "examples/react-todo": {
      "entry": [
        "page.js",
        "test/**/*.test.ts"
      ],
      "project": [
        "*.{ts,js}",
        "test/**/*.ts"
      ]
    },
    "examples/rich-editor": {
      "entry": [
        "page.js",
        "test/**/*.test.ts"
      ],
      "project": [
        "*.{ts,js}",
        "test/**/*.ts"
      ]
    },
    "examples/text-editor": {
      "entry": [
        "page.js",
        "test/**/*.test.ts"
      ],
      "project": [
        "*.{ts,js}",
        "test/**/*.ts"
      ]
    }
  }
}
