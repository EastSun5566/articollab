{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": ["packages/articollab/src/**/*.ts", "test/**/*.ts", "examples/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["examples/text-editor", "examples/rich-editor", "examples/kanban", "examples/file-tree", "examples/react-todo", "examples/tiptap-react"]
}
