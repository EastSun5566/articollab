{
  "name": "articollab",
  "version": "0.1.0",
  "private": true,
  "description": "Server-authoritative collaborative collections powered by articulated.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "test:package": "node --unhandled-rejections=strict --test test/package-consumer/smoke.test.ts",
    "test:coverage": "node --experimental-test-coverage --test test/*.test.ts"
  },
  "dependencies": {
    "articulated": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
