{
  "name": "articollab",
  "version": "0.1.0-beta.0",
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "beta"
  },
  "description": "Server-authoritative collaborative collections powered by articulated.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EastSun5566/articollab.git"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "release": "commit-and-tag-version --sign",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "knip": "knip --no-progress --treat-config-hints-as-errors",
    "docs:build": "node scripts/docs.ts build",
    "docs:check": "node scripts/docs.ts check",
    "docs:serve": "node scripts/docs.ts serve",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "test:package": "node --unhandled-rejections=strict --test test/package-consumer/smoke.test.ts",
    "test:coverage": "node --experimental-test-coverage --test test/*.test.ts"
  },
  "dependencies": {
    "articulated": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "commit-and-tag-version": "^13.2.1",
    "knip": "^6.39.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2"
  }
}
