{
  "name": "articollab-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "release": "commit-and-tag-version --sign",
    "lint": "oxlint --disable-nested-config --deny-warnings --report-unused-disable-directives",
    "knip": "knip --no-progress --treat-config-hints-as-errors",
    "docs:check": "node scripts/docs.ts check",
    "docs:serve": "node scripts/docs.ts serve",
    "build": "pnpm --filter articollab build",
    "bench": "pnpm --silent build && node --expose-gc scripts/bench.ts",
    "check": "tsc -p tsconfig.json",
    "test": "pnpm --silent build && node --test --test-concurrency=2 test/*.test.ts",
    "test:package": "node --unhandled-rejections=strict --test test/package-consumer/smoke.test.ts",
    "test:coverage": "pnpm --silent build && node --experimental-test-coverage --test --test-concurrency=2 test/*.test.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "articollab": "workspace:*",
    "articulated": "^1.4.0",
    "commit-and-tag-version": "^13.2.1",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "knip": "^6.39.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "pg": "^8.23.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.13",
    "prosemirror-schema-basic": "^1.2.5",
    "prosemirror-schema-list": "^1.6.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.44.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "ws": "^8.23.0"
  }
}
